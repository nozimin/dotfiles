#!/bin/bash
# Claude Code と Codex に dotfiles の Agent Skills をインストールする。
# shellcheck disable=SC2088 # メッセージ中の ~ は表示用

# shellcheck source=cmd/common.sh disable=SC1091
source "$(dirname "$0")/common.sh"
# shellcheck source=cmd/skills_common.sh disable=SC1091
source "$(dirname "$0")/skills_common.sh"
# shellcheck source=cmd/skills_lock.sh disable=SC1091
source "$(dirname "$0")/skills_lock.sh"

if [ "$#" -ne 0 ]; then
  error "引数は指定できません"
  exit 2
fi

CLAUDE_MARKETPLACE="$REPO_ROOT/lib/agents"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CONFIG_DIR="$HOME/.config/dotfiles"
REPO_POINTER="$CONFIG_DIR/repo"
MIGRATION_MARKER="$CONFIG_DIR/repo.migrating"
INSTALL_LOCK_DIR="$CONFIG_DIR/install_skills.lock"
REPO_POINTER_TMP=""
MIGRATION_MARKER_TMP=""
CODEX_MARKETPLACE_ERROR_TMP=""
LOCK_HELD=0
CLAUDE_AVAILABLE=0
CODEX_AVAILABLE=0
CLAUDE_MARKETPLACE_PATH=""
CODEX_MARKETPLACE_PATH=""
CLAUDE_STATE="missing"
CODEX_STATE="missing"

cleanup() {
  [ -z "$REPO_POINTER_TMP" ] || rm -f "$REPO_POINTER_TMP"
  [ -z "$MIGRATION_MARKER_TMP" ] || rm -f "$MIGRATION_MARKER_TMP"
  [ -z "$CODEX_MARKETPLACE_ERROR_TMP" ] || rm -f "$CODEX_MARKETPLACE_ERROR_TMP"
  skills_lock_release
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

json_marketplace_path() {
  local json="$1" host="$2" path
  path="$(printf '%s\n' "$json" | python3 -c '
import json, sys
host = sys.argv[1]
try:
    data = json.load(sys.stdin)
    if host == "claude":
        if not isinstance(data, list):
            raise ValueError("expected marketplace list")
        records = data
    else:
        if not isinstance(data, dict) or not isinstance(data.get("marketplaces"), list):
            raise ValueError("expected marketplace list")
        records = data["marketplaces"]
    for record in records:
        if record.get("name") == "dotfiles":
            value = record.get("path") or record.get("root") or record.get("installLocation")
            if value:
                print(value)
            break
except Exception:
    sys.exit(1)
' "$host")" || return 1
  printf '%s\n' "$path"
}

json_codex_marketplace_path() {
  local json="$1" path
  path="$(printf '%s\n' "$json" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
    if not isinstance(data, dict):
        raise ValueError("expected plugin list object")
    for group in ("installed", "available"):
        records = data.get(group, [])
        if not isinstance(records, list):
            raise ValueError("expected plugin list")
        for plugin in records:
            if plugin.get("marketplaceName") == "dotfiles":
                source = plugin.get("marketplaceSource", {})
                if source.get("sourceType") == "local" and isinstance(source.get("source"), str):
                    print(source["source"])
                    sys.exit(0)
    print("")
except Exception:
    sys.exit(1)
')" || return 1
  printf '%s\n' "$path"
}

preflight_claude() {
  local marketplaces
  command -v claude >/dev/null 2>&1 || return 0
  CLAUDE_AVAILABLE=1
  marketplaces="$(claude plugin marketplace list --json)" || {
    error "Claude Code の marketplace を確認できませんでした"
    return 1
  }
  CLAUDE_MARKETPLACE_PATH="$(json_marketplace_path "$marketplaces" claude)" || {
    error "Claude Code の marketplace JSON を解析できませんでした"
    return 1
  }
  CLAUDE_STATE="$(claude_plugin_state)" || return 1
}

preflight_codex() {
  local plugins list_error configured_path
  command -v codex >/dev/null 2>&1 || return 0
  CODEX_AVAILABLE=1
  # codex CLI requires CODEX_HOME to exist, but creating it is deferred until after confirmation.
  if [ ! -d "$CODEX_HOME" ]; then
    return 0
  fi
  CODEX_MARKETPLACE_ERROR_TMP="$(mktemp "${TMPDIR:-/tmp}/dotfiles-codex-marketplace.XXXXXX")" || {
    error "Codex の marketplace 確認用一時ファイルを作成できませんでした"
    return 1
  }
  if ! plugins="$(codex plugin list --marketplace dotfiles --available --json 2>"$CODEX_MARKETPLACE_ERROR_TMP")"; then
    list_error="$(cat "$CODEX_MARKETPLACE_ERROR_TMP")"
    configured_path="$(stale_pointer_marketplace_path)" || {
      error "Codex の dotfiles plugin を確認できませんでした: $list_error"
      return 1
    }
    CODEX_MARKETPLACE_PATH="$configured_path"
    CODEX_STATE="missing"
    rm -f "$CODEX_MARKETPLACE_ERROR_TMP"
    CODEX_MARKETPLACE_ERROR_TMP=""
    return 0
  fi
  rm -f "$CODEX_MARKETPLACE_ERROR_TMP"
  CODEX_MARKETPLACE_ERROR_TMP=""
  CODEX_MARKETPLACE_PATH="$(json_codex_marketplace_path "$plugins")" || {
    error "Codex の dotfiles plugin JSON を解析できませんでした"
    return 1
  }
  CODEX_STATE="$(codex_plugin_state_from_json "$plugins")" || return 1
}

codex_marketplace_manifest_is_valid() {
  local marketplace="$1"
  OLD_MARKETPLACE="$marketplace" python3 - <<'PY'
import json, os
try:
    root = os.path.realpath(os.environ["OLD_MARKETPLACE"])
    with open(os.path.join(root, ".claude-plugin", "marketplace.json"), encoding="utf-8") as f:
        manifest = json.load(f)
    plugin = next(p for p in manifest.get("plugins", []) if p.get("name") == "nozimin")
    source = plugin.get("source")
    source_path = os.path.realpath(os.path.join(root, source)) if isinstance(source, str) and source else ""
    valid = (manifest.get("name") == "dotfiles" and source_path.startswith(root + os.sep)
             and os.path.isdir(source_path))
except Exception:
    valid = False
raise SystemExit(0 if valid else 1)
PY
}

stale_pointer_marketplace_path() {
  local old_repo old_marketplace
  # A failed migration may have moved its target again. Check that recorded target
  # before the still-valid repo pointer, since Codex may now point there.
  if [ -f "$MIGRATION_MARKER" ] && [ ! -L "$MIGRATION_MARKER" ]; then
    old_repo="$(cat "$MIGRATION_MARKER")"
    if [ -n "$old_repo" ] && [ "$old_repo" != "$REPO_ROOT" ]; then
      old_marketplace="$old_repo/lib/agents"
      if ! codex_marketplace_manifest_is_valid "$old_marketplace"; then
        printf '%s\n' "$old_marketplace"
        return 0
      fi
    fi
  fi
  [ -f "$REPO_POINTER" ] && [ ! -L "$REPO_POINTER" ] || return 1
  old_repo="$(cat "$REPO_POINTER")"
  [ -n "$old_repo" ] && [ "$old_repo" != "$REPO_ROOT" ] || return 1
  old_marketplace="$old_repo/lib/agents"
  codex_marketplace_manifest_is_valid "$old_marketplace" && return 1
  printf '%s\n' "$old_marketplace"
}

validate_repo_pointer_destination() {
  if [ -e "$REPO_POINTER" ] || [ -L "$REPO_POINTER" ]; then
    if [ ! -f "$REPO_POINTER" ] || [ -L "$REPO_POINTER" ]; then
      error "$REPO_POINTER は通常ファイルではありません。plugin 設定は変更していません"
      return 1
    fi
  fi
}

prepare_repo_pointer() {
  mkdir -p "$CONFIG_DIR" || {
    error "$CONFIG_DIR を作成できませんでした"
    return 1
  }
  validate_repo_pointer_destination || return 1
  if [ -f "$REPO_POINTER" ] && [ "$(cat "$REPO_POINTER")" = "$REPO_ROOT" ]; then
    return 0
  fi
  REPO_POINTER_TMP="$(mktemp "$CONFIG_DIR/.repo.XXXXXX")" || {
    error "$REPO_POINTER を更新する一時ファイルを作成できませんでした"
    return 1
  }
  printf '%s\n' "$REPO_ROOT" >"$REPO_POINTER_TMP" || {
    error "$REPO_POINTER を更新する内容を書き込めませんでした"
    return 1
  }
}

begin_pointer_migration() {
  if [ -e "$MIGRATION_MARKER" ] || [ -L "$MIGRATION_MARKER" ]; then
    if [ ! -f "$MIGRATION_MARKER" ] || [ -L "$MIGRATION_MARKER" ]; then
      error "$MIGRATION_MARKER を通常ファイルとして扱えません。plugin 設定は変更していません"
      return 1
    fi
    if [ "$(cat "$MIGRATION_MARKER")" = "$REPO_ROOT" ]; then
      warn "未完了の移行を検出しました。skills は移行完了まで停止中です"
      return 0
    fi
    MIGRATION_MARKER_TMP="$(mktemp "$CONFIG_DIR/.repo.migrating.XXXXXX")" || {
      error "移行中 marker の移行先を更新する一時ファイルを作成できませんでした"
      return 1
    }
    printf '%s\n' "$REPO_ROOT" >"$MIGRATION_MARKER_TMP" || return 1
    mv "$MIGRATION_MARKER_TMP" "$MIGRATION_MARKER" || {
      error "移行中 marker を新しい clone に更新できませんでした。plugin 設定は変更していません"
      return 1
    }
    MIGRATION_MARKER_TMP=""
    ok "移行中 marker を現在の clone に更新しました"
    return 0
  fi
  MIGRATION_MARKER_TMP="$(mktemp "$CONFIG_DIR/.repo.migrating.XXXXXX")" || {
    error "移行中 marker を作成できませんでした"
    return 1
  }
  printf '%s\n' "$REPO_ROOT" >"$MIGRATION_MARKER_TMP" || return 1
  mv "$MIGRATION_MARKER_TMP" "$MIGRATION_MARKER" || {
    error "移行中 marker を有効にできませんでした"
    return 1
  }
  MIGRATION_MARKER_TMP=""
}

install_claude_skills() {
  if [ "$CLAUDE_AVAILABLE" -eq 0 ]; then
    warn "Claude Code が見つからないため、skills をスキップしました"
    return 0
  fi

  if [ -n "$CLAUDE_MARKETPLACE_PATH" ] && [ "$CLAUDE_MARKETPLACE_PATH" != "$CLAUDE_MARKETPLACE" ]; then
    if [ "$CLAUDE_STATE" != missing ]; then
      claude plugin uninstall nozimin@dotfiles --scope user >/dev/null 2>&1 || true
    fi
    claude plugin marketplace remove dotfiles --json >/dev/null || {
      error "Claude Code の古い dotfiles marketplace を削除できませんでした"
      return 1
    }
    CLAUDE_MARKETPLACE_PATH=""
    CLAUDE_STATE="missing"
  fi

  if [ -z "$CLAUDE_MARKETPLACE_PATH" ]; then
    claude plugin marketplace add "$CLAUDE_MARKETPLACE" --scope user --json >/dev/null || {
      error "Claude Code に dotfiles marketplace を登録できませんでした"
      return 1
    }
    ok "Claude Code に dotfiles marketplace を登録しました"
  else
    ok "Claude Code の dotfiles marketplace は登録済み"
  fi

  case "$CLAUDE_STATE" in
    enabled) ok "Claude Code の nozimin plugin はインストール済み" ;;
    disabled)
      claude plugin enable nozimin@dotfiles || {
        error "Claude Code の nozimin plugin を有効にできませんでした"
        return 1
      }
      ok "Claude Code の nozimin plugin を有効にしました"
      ;;
    missing)
      claude plugin install nozimin@dotfiles --scope user --json >/dev/null || {
        error "Claude Code に nozimin plugin をインストールできませんでした"
        return 1
      }
      ok "Claude Code の nozimin plugin をインストールしました"
      ;;
  esac
}

codex_cache_executable_modes_match() {
  python3 - "$1" "$2" <<'PY'
import os, stat, sys
source, cache = sys.argv[1:]
for root, dirs, files in os.walk(source, followlinks=False):
    rel_root = os.path.relpath(root, source)
    for name in files:
        src = os.path.join(root, name)
        rel = os.path.normpath(os.path.join(rel_root, name))
        dst = os.path.join(cache, rel)
        if os.path.islink(src) or not os.path.isfile(dst) or os.path.islink(dst):
            continue
        src_exec = stat.S_IMODE(os.stat(src).st_mode) & 0o111
        dst_exec = stat.S_IMODE(os.stat(dst).st_mode) & 0o111
        if src_exec != dst_exec:
            sys.exit(1)
sys.exit(0)
PY
}

install_codex_skills() {
  local cache_dir
  if [ "$CODEX_AVAILABLE" -eq 0 ]; then
    warn "Codex が見つからないため、skills をスキップしました"
    return 0
  fi
  mkdir -p "$CODEX_HOME" || {
    error "Codex の設定ディレクトリを作成できませんでした: $CODEX_HOME"
    return 1
  }

  if [ -n "$CODEX_MARKETPLACE_PATH" ] && [ "$CODEX_MARKETPLACE_PATH" != "$CLAUDE_MARKETPLACE" ]; then
    codex plugin marketplace remove dotfiles --json >/dev/null || {
      error "Codex の古い dotfiles marketplace を削除できませんでした"
      return 1
    }
    CODEX_MARKETPLACE_PATH=""
    CODEX_STATE="missing"
  fi

  if [ -z "$CODEX_MARKETPLACE_PATH" ]; then
    codex plugin marketplace add "$CLAUDE_MARKETPLACE" --json >/dev/null || {
      error "Codex に dotfiles marketplace を登録できませんでした"
      return 1
    }
    ok "Codex に dotfiles marketplace を登録しました"
  else
    ok "Codex の dotfiles marketplace は登録済み"
  fi

  cache_dir="$CODEX_HOME/plugins/cache/dotfiles/nozimin/local"
  if [ "$CODEX_STATE" = enabled ] &&
    diff -qr "$REPO_ROOT/lib/agents/nozimin" "$cache_dir" >/dev/null 2>&1 &&
    codex_cache_executable_modes_match "$REPO_ROOT/lib/agents/nozimin" "$cache_dir"; then
    ok "Codex の nozimin plugin は最新"
    return 0
  fi

  # `plugin add` refreshes the local cache in place, including removed files.
  codex plugin add nozimin@dotfiles --json >/dev/null || {
    error "Codex に nozimin plugin をインストールまたは更新できませんでした"
    return 1
  }
  ok "Codex の nozimin plugin をインストールまたは更新しました"
}

if [ "${DOTFILES_SETUP_LOCK_OWNER_PID:-}" = "$PPID" ] && skills_lock_is_owned_by "$PPID"; then
  : # cmd/setup owns and releases the validated shared lock
else
  skills_lock_acquire || exit 1
fi
preflight_claude || exit 1
preflight_codex || exit 1

MIGRATION_REQUIRED=0
if [ -f "$REPO_POINTER" ] && [ "$(cat "$REPO_POINTER")" != "$REPO_ROOT" ]; then
  MIGRATION_REQUIRED=1
fi
if { [ -n "$CLAUDE_MARKETPLACE_PATH" ] && [ "$CLAUDE_MARKETPLACE_PATH" != "$CLAUDE_MARKETPLACE" ]; } ||
  { [ -n "$CODEX_MARKETPLACE_PATH" ] && [ "$CODEX_MARKETPLACE_PATH" != "$CLAUDE_MARKETPLACE" ]; }; then
  MIGRATION_REQUIRED=1
fi
if [ -e "$MIGRATION_MARKER" ] || [ -L "$MIGRATION_MARKER" ]; then
  MIGRATION_REQUIRED=1
fi
if [ "$MIGRATION_REQUIRED" -eq 1 ]; then
  ask_yes_no "既存の dotfiles skills の参照先を $(pretty_path "$REPO_ROOT") に切り替えますか？" || {
    warn "移行をスキップしました。marketplace と repo pointer は変更していません"
    exit 2
  }
fi

prepare_repo_pointer || exit 1
if [ "$MIGRATION_REQUIRED" -eq 1 ] || [ -n "$REPO_POINTER_TMP" ]; then
  begin_pointer_migration || exit 1
fi

step "Claude Code"
install_claude_skills || exit 1
step "Codex"
install_codex_skills || exit 1

if [ -n "$REPO_POINTER_TMP" ]; then
  mv "$REPO_POINTER_TMP" "$REPO_POINTER" || {
    error "$REPO_POINTER を更新できませんでした"
    exit 1
  }
  REPO_POINTER_TMP=""
  ok "dotfiles リポジトリの場所を更新しました"
else
  ok "dotfiles リポジトリの場所は登録済み"
fi

if [ -e "$MIGRATION_MARKER" ]; then
  rm -f "$MIGRATION_MARKER" || {
    error "repo pointer は更新しましたが、移行中 marker を削除できませんでした。cmd/install_skills を再実行してください"
    exit 1
  }
fi
