#!/bin/bash
# Claude Code と Codex に dotfiles の Agent Skills をインストールする。
# shellcheck disable=SC2088 # メッセージ中の ~ は表示用

# shellcheck source=cmd/common.sh disable=SC1091
source "$(dirname "$0")/common.sh"
# shellcheck source=cmd/skills_common.sh disable=SC1091
source "$(dirname "$0")/skills_common.sh"

if [ "$#" -ne 0 ]; then
  error "引数は指定できません"
  exit 2
fi

CLAUDE_MARKETPLACE="$REPO_ROOT/lib/agents"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CONFIG_DIR="$HOME/.config/dotfiles"
REPO_POINTER="$CONFIG_DIR/repo"
REPO_POINTER_TMP=""
CLAUDE_AVAILABLE=0
CODEX_AVAILABLE=0
CLAUDE_MARKETPLACE_PATH=""
CODEX_MARKETPLACE_PATH=""
CLAUDE_STATE="missing"
CODEX_STATE="missing"

cleanup() {
  [ -z "$REPO_POINTER_TMP" ] || rm -f "$REPO_POINTER_TMP"
}
trap cleanup EXIT

json_marketplace_path() {
  local json="$1" host="$2" path
  path="$(printf '%s\n' "$json" | python3 -c '
import json, sys
host = sys.argv[1]
try:
    data = json.load(sys.stdin)
    if host == "claude":
        if not isinstance(data, list):
            raise ValueError("expected marketplace list")
        records = data
    else:
        if not isinstance(data, dict) or not isinstance(data.get("marketplaces"), list):
            raise ValueError("expected marketplace list")
        records = data["marketplaces"]
    for record in records:
        if record.get("name") == "dotfiles":
            value = record.get("path") or record.get("root") or record.get("installLocation")
            if value:
                print(value)
            break
except Exception:
    sys.exit(1)
' "$host")" || return 1
  printf '%s\n' "$path"
}

preflight_claude() {
  local marketplaces
  command -v claude >/dev/null 2>&1 || return 0
  CLAUDE_AVAILABLE=1
  marketplaces="$(claude plugin marketplace list --json)" || {
    error "Claude Code の marketplace を確認できませんでした"
    return 1
  }
  CLAUDE_MARKETPLACE_PATH="$(json_marketplace_path "$marketplaces" claude)" || {
    error "Claude Code の marketplace JSON を解析できませんでした"
    return 1
  }
  CLAUDE_STATE="$(claude_plugin_state)" || return 1
}

preflight_codex() {
  local marketplaces
  command -v codex >/dev/null 2>&1 || return 0
  CODEX_AVAILABLE=1
  # codex CLI requires CODEX_HOME to exist, but creating it is deferred until after confirmation.
  if [ ! -d "$CODEX_HOME" ]; then
    return 0
  fi
  marketplaces="$(codex plugin marketplace list --json)" || {
    error "Codex の marketplace を確認できませんでした"
    return 1
  }
  CODEX_MARKETPLACE_PATH="$(json_marketplace_path "$marketplaces" codex)" || {
    error "Codex の marketplace JSON を解析できませんでした"
    return 1
  }
  CODEX_STATE="$(codex_plugin_state)" || return 1
}

prepare_repo_pointer() {
  mkdir -p "$CONFIG_DIR" || {
    error "$CONFIG_DIR を作成できませんでした"
    return 1
  }
  if [ -f "$REPO_POINTER" ] && [ "$(cat "$REPO_POINTER")" = "$REPO_ROOT" ]; then
    return 0
  fi
  REPO_POINTER_TMP="$(mktemp "$CONFIG_DIR/.repo.XXXXXX")" || {
    error "$REPO_POINTER を更新する一時ファイルを作成できませんでした"
    return 1
  }
  printf '%s\n' "$REPO_ROOT" >"$REPO_POINTER_TMP" || {
    error "$REPO_POINTER を更新する内容を書き込めませんでした"
    return 1
  }
}

install_claude_skills() {
  if [ "$CLAUDE_AVAILABLE" -eq 0 ]; then
    warn "Claude Code が見つからないため、skills をスキップしました"
    return 0
  fi

  if [ -n "$CLAUDE_MARKETPLACE_PATH" ] && [ "$CLAUDE_MARKETPLACE_PATH" != "$CLAUDE_MARKETPLACE" ]; then
    if [ "$CLAUDE_STATE" != missing ]; then
      claude plugin uninstall nozimin@dotfiles --scope user >/dev/null 2>&1 || true
    fi
    claude plugin marketplace remove dotfiles --json >/dev/null || {
      error "Claude Code の古い dotfiles marketplace を削除できませんでした"
      return 1
    }
    CLAUDE_MARKETPLACE_PATH=""
    CLAUDE_STATE="missing"
  fi

  if [ -z "$CLAUDE_MARKETPLACE_PATH" ]; then
    claude plugin marketplace add "$CLAUDE_MARKETPLACE" --scope user --json >/dev/null || {
      error "Claude Code に dotfiles marketplace を登録できませんでした"
      return 1
    }
    ok "Claude Code に dotfiles marketplace を登録しました"
  else
    ok "Claude Code の dotfiles marketplace は登録済み"
  fi

  case "$CLAUDE_STATE" in
    enabled) ok "Claude Code の nozimin plugin はインストール済み" ;;
    disabled)
      claude plugin enable nozimin@dotfiles || {
        error "Claude Code の nozimin plugin を有効にできませんでした"
        return 1
      }
      ok "Claude Code の nozimin plugin を有効にしました"
      ;;
    missing)
      claude plugin install nozimin@dotfiles --scope user --json >/dev/null || {
        error "Claude Code に nozimin plugin をインストールできませんでした"
        return 1
      }
      ok "Claude Code の nozimin plugin をインストールしました"
      ;;
  esac
}

install_codex_skills() {
  local cache_dir
  if [ "$CODEX_AVAILABLE" -eq 0 ]; then
    warn "Codex が見つからないため、skills をスキップしました"
    return 0
  fi
  mkdir -p "$CODEX_HOME" || {
    error "Codex の設定ディレクトリを作成できませんでした: $CODEX_HOME"
    return 1
  }

  if [ -n "$CODEX_MARKETPLACE_PATH" ] && [ "$CODEX_MARKETPLACE_PATH" != "$CLAUDE_MARKETPLACE" ]; then
    codex plugin marketplace remove dotfiles --json >/dev/null || {
      error "Codex の古い dotfiles marketplace を削除できませんでした"
      return 1
    }
    CODEX_MARKETPLACE_PATH=""
    CODEX_STATE="missing"
  fi

  if [ -z "$CODEX_MARKETPLACE_PATH" ]; then
    codex plugin marketplace add "$CLAUDE_MARKETPLACE" --json >/dev/null || {
      error "Codex に dotfiles marketplace を登録できませんでした"
      return 1
    }
    ok "Codex に dotfiles marketplace を登録しました"
  else
    ok "Codex の dotfiles marketplace は登録済み"
  fi

  cache_dir="$CODEX_HOME/plugins/cache/dotfiles/nozimin/local"
  if [ "$CODEX_STATE" = enabled ] && diff -qr "$REPO_ROOT/lib/agents/nozimin" "$cache_dir" >/dev/null 2>&1; then
    ok "Codex の nozimin plugin は最新"
    return 0
  fi

  # `plugin add` refreshes the local cache in place, including removed files.
  codex plugin add nozimin@dotfiles --json >/dev/null || {
    error "Codex に nozimin plugin をインストールまたは更新できませんでした"
    return 1
  }
  ok "Codex の nozimin plugin をインストールまたは更新しました"
}

preflight_claude || exit 1
preflight_codex || exit 1

MIGRATION_REQUIRED=0
if [ -f "$REPO_POINTER" ] && [ "$(cat "$REPO_POINTER")" != "$REPO_ROOT" ]; then
  MIGRATION_REQUIRED=1
fi
if { [ -n "$CLAUDE_MARKETPLACE_PATH" ] && [ "$CLAUDE_MARKETPLACE_PATH" != "$CLAUDE_MARKETPLACE" ]; } ||
  { [ -n "$CODEX_MARKETPLACE_PATH" ] && [ "$CODEX_MARKETPLACE_PATH" != "$CLAUDE_MARKETPLACE" ]; }; then
  MIGRATION_REQUIRED=1
fi
if [ "$MIGRATION_REQUIRED" -eq 1 ]; then
  ask_yes_no "既存の dotfiles skills の参照先を $(pretty_path "$REPO_ROOT") に切り替えますか？" || {
    warn "移行をスキップしました。marketplace と repo pointer は変更していません"
    exit 2
  }
fi

prepare_repo_pointer || exit 1

step "Claude Code"
install_claude_skills || exit 1
step "Codex"
install_codex_skills || exit 1

if [ -n "$REPO_POINTER_TMP" ]; then
  mv "$REPO_POINTER_TMP" "$REPO_POINTER" || {
    error "$REPO_POINTER を更新できませんでした"
    exit 1
  }
  REPO_POINTER_TMP=""
  ok "dotfiles リポジトリの場所を更新しました"
else
  ok "dotfiles リポジトリの場所は登録済み"
fi
