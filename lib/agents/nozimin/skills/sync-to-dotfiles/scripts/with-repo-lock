#!/bin/bash
# Validate an approved repository target and serialize one write operation with installer migrations.
# Usage: with-repo-lock <expected-repo> -- <command> [args...]

set -eu

fatal() {
  printf 'with-repo-lock: %s\n' "$*" >&2
  exit 1
}

[ "$#" -ge 3 ] || fatal "使い方: with-repo-lock <確認済みrepo path> -- <command> [args...]"
EXPECTED_REPO="$1"
shift
[ "$1" = -- ] || fatal "repo path の後に -- が必要です"
shift
[ "$#" -gt 0 ] || fatal "実行する command がありません"

EXPECTED_REPO="$(cd "$EXPECTED_REPO" 2>/dev/null && pwd -P)" || fatal "repo pointer が欠落しているか古い clone を指しています。現在の dotfiles clone から cmd/install_skills を実行してください"
CONFIG_DIR="$HOME/.config/dotfiles"
REPO_POINTER="$CONFIG_DIR/repo"
MIGRATION_MARKER="$CONFIG_DIR/repo.migrating"
# shellcheck disable=SC2034 # consumed by skills_lock.sh
INSTALL_LOCK_DIR="$CONFIG_DIR/install_skills.lock"

validate_repo_target() {
  local current_repo
  if [ -e "$MIGRATION_MARKER" ] || [ -L "$MIGRATION_MARKER" ]; then
    fatal "Agent Skills の移行が進行中です。移行先 clone の cmd/install_skills を再実行してから、collect と選択をやり直してください"
  fi
  current_repo="$(skills_repo_pointer_target "$REPO_POINTER")" || fatal "repo pointer がありません、空、または有効な dotfiles clone を指していません。現在の dotfiles clone から cmd/install_skills を実行してください"
  [ "$current_repo" = "$EXPECTED_REPO" ] || fatal "確認時の repo ($EXPECTED_REPO) と現在の repo ($current_repo) が異なります。変更を行わず、collect と承認からやり直してください"
}

[ -f "$EXPECTED_REPO/cmd/common.sh" ] && [ -f "$EXPECTED_REPO/cmd/skills_lock.sh" ] || fatal "確認済み repo の lock support が見つかりません"
# shellcheck source=/dev/null
source "$EXPECTED_REPO/cmd/common.sh"
# shellcheck source=/dev/null
source "$EXPECTED_REPO/cmd/skills_lock.sh"
validate_repo_target
# shellcheck disable=SC2034 # consumed by skills_lock.sh
LOCK_HELD=0
trap skills_lock_release EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

skills_lock_acquire || exit 1
validate_repo_target
cd "$EXPECTED_REPO"
"$@"
