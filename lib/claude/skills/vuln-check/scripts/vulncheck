#!/bin/bash
# vuln-check skill の決定的な処理（収集・照合・バージョン比較）。仕様は docs/specs/vuln-check.md。
# 読み取り専用。パッケージやアプリ、brew のメタデータを変更しない。
#
# 構成（サブコマンドを足すときに読む）
# - サブコマンド <名前> は関数 cmd_<名前> で実装する。main は関数があれば呼び、無ければ「未実装」で失敗する。
#   cmd_<名前> はエンベロープ（1 行の JSON）を標準出力に出す。main がまとめて 1 つの配列にする。
# - envelope <ソース> <層> <状態> <件数> <evidence の JSON> [補足...] < items の JSON 配列
#   envelope_error <ソース> <層> <evidence の JSON> <補足...>
# - fetch_source <ソース> <層> <URL> <保存先> [curl のオプション...]
#   取得に失敗したら error、空なら warn のエンベロープを出して 1 を返す。呼び出し側は `|| return 0` で抜ける。
#   URL は下の *_URL を使う（VULNCHECK_*_URL で差し替え、file:// も可）。エンベロープを作らない取得は fetch。
#   多数の URL を並列に取るときは fetch_many（1 件ごとの結果を出す）。
# - run_source <ソース> <層> <関数> [引数...]
#   関数をサブシェルで実行し、途中で失敗したら error のエンベロープにする。ソースごとに囲み、他のソースを止めない。
# - inventory_items [kind...] でインベントリの項目を JSON 配列で得る（--inventory が無ければその場で集める）。
#   エンベロープごと読むときは ensure_inventory のあと $INVENTORY_FILE を jq で読む。
#   照合に使う kind のインベントリが取得失敗かどうかは inventory_notes [kind...] で補足として得る。
# - now_epoch / now_iso は現在時刻（VULNCHECK_NOW で差し替え）。iso_to_epoch / epoch_to_iso で変換する。
# - version_compare <A> <B> は lt / eq / gt を出す。比較できなければ 2 を返す。
# - 一時ファイルは $WORK_DIR に置く（終了時に消す）。
# - bash 3.2 では $(...) の中で set -e が効かない。$(...) の中で呼ぶ関数は、失敗を自分で return する。

set -euo pipefail

# 取得元（§3.3）
# shellcheck disable=SC2034 # 各サブコマンドで使う
{
  OSV_URL="${VULNCHECK_OSV_URL:-https://api.osv.dev}"
  BREW_FORMULA_URL="${VULNCHECK_BREW_FORMULA_URL:-https://formulae.brew.sh/api/formula}"
  BREW_CASK_URL="${VULNCHECK_BREW_CASK_URL:-https://formulae.brew.sh/api/cask.json}"
  ITUNES_URL="${VULNCHECK_ITUNES_URL:-https://itunes.apple.com/lookup}"
  EOL_URL="${VULNCHECK_EOL_URL:-https://endoflife.date/api}"
  KEV_URL="${VULNCHECK_KEV_URL:-https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json}"
  JVN_IPEDIA_URL="${VULNCHECK_JVN_IPEDIA_URL:-https://jvndb.jvn.jp/ja/rss/jvndb_new.rdf}"
  JVN_URL="${VULNCHECK_JVN_URL:-https://jvn.jp/rss/jvn.rdf}"
  JPCERT_URL="${VULNCHECK_JPCERT_URL:-https://www.jpcert.or.jp/rss/jpcert.rdf}"
  VSCODE_REMOVED_URL="${VULNCHECK_VSCODE_REMOVED_URL:-https://raw.githubusercontent.com/microsoft/vsmarketplace/main/RemovedPackages.md}"
}

FETCH_TIMEOUT=60
PLIST_BUDDY=/usr/libexec/PlistBuddy
APPS_DIR=/Applications
VSCODE_APP_CLI="$APPS_DIR/Visual Studio Code.app/Contents/Resources/app/bin/code"

INVENTORY_FILE=""
NOW_EPOCH=""
WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/vulncheck.XXXXXX")"
trap 'rm -rf "$WORK_DIR"' EXIT
BREW_JSON="$WORK_DIR/brew-installed.json"

die() {
  printf 'vulncheck: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
使い方: vulncheck <サブコマンド>

  inventory                   インベントリを集める
  osv [--inventory FILE]      言語パッケージを OSV で照合する
  latest [--inventory FILE]   brew・アプリ・OS・ランタイムを最新版と比べる
  vscode [--inventory FILE]   VS Code 拡張を削除済み一覧と照合する
  kev [--inventory FILE]      KEV から照合候補を出す
  jvn [--inventory FILE]      JVN iPedia と JVN の直近 30 日から照合候補を出す
  jpcert                      JPCERT/CC 注意喚起の直近 30 日を出す
  compare A B                 バージョンを比べて lt / eq / gt を出す
  all                         inventory とその他すべてを実行する

出力はエンベロープの JSON 配列（compare を除く）。
--inventory を省略すると、その場で inventory を実行する。
EOF
}

has_command() {
  command -v "$1" >/dev/null 2>&1
}

# iso_to_epoch <日時>
# ISO 8601（2026-11-09、2026-11-09T15:30、2026-11-09T15:30:00+09:00、…Z）をエポック秒にする。
# 時差が無ければローカル時刻として扱う。解釈できなければ 1 を返す。
iso_to_epoch() {
  local re='^([0-9]{4}-[0-9]{2}-[0-9]{2})(T([0-9]{2}:[0-9]{2})(:[0-9]{2})?(\.[0-9]+)?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$'
  local datetime zone
  [[ $1 =~ $re ]] || return 1
  datetime="${BASH_REMATCH[1]} ${BASH_REMATCH[3]:-00:00}${BASH_REMATCH[4]:-:00}"
  zone="${BASH_REMATCH[6]:-}"
  case "$zone" in
    "") date -j -f '%Y-%m-%d %H:%M:%S' "$datetime" +%s ;;
    Z) date -j -f '%Y-%m-%d %H:%M:%S%z' "$datetime+0000" +%s ;;
    *) date -j -f '%Y-%m-%d %H:%M:%S%z' "$datetime${zone/:/}" +%s ;;
  esac
}

# epoch_to_iso <エポック秒>
# ローカル時刻の ISO 8601（2026-11-09T15:30:00+09:00）にする。
epoch_to_iso() {
  local s
  s="$(date -j -r "$1" '+%Y-%m-%dT%H:%M:%S%z')" || return 1
  printf '%s:%s\n' "${s%??}" "${s: -2}"
}

now_epoch() {
  if [ -n "$NOW_EPOCH" ]; then
    echo "$NOW_EPOCH"
  else
    date +%s
  fi
}

now_iso() {
  epoch_to_iso "$(now_epoch)"
}

# envelope <ソース> <層> <状態> <件数> <evidence の JSON> [補足...]
# 標準入力の items（JSON 配列）からエンベロープを 1 つ組み立て、1 行の JSON で出す（§3.1）。
envelope() {
  local source="$1" layer="$2" status="$3" count="$4" evidence="$5" fetched_at
  shift 5
  case "$status" in
    ok | warn | error) ;;
    *) die "envelope: 状態が不正です: $status" ;;
  esac
  fetched_at="$(now_iso)" || return 1
  jq -c --arg source "$source" --arg layer "$layer" --arg status "$status" \
    --argjson count "$count" --argjson evidence "$evidence" --arg fetched_at "$fetched_at" \
    '{source: $source, layer: $layer, status: $status, count: $count, fetched_at: $fetched_at,
      evidence: $evidence, notes: $ARGS.positional, items: .}' --args -- "$@"
}

# envelope_error <ソース> <層> <evidence の JSON> <補足...>
envelope_error() {
  local source="$1" layer="$2" evidence="$3"
  shift 3
  echo '[]' | envelope "$source" "$layer" error 0 "$evidence" "$@"
}

# fetch <URL> <保存先> [curl のオプション...]
# 失敗したら（HTTP エラー、タイムアウト、file:// のファイルが無い）curl のメッセージを標準エラーに出して非 0 を返す。
fetch() {
  local url="$1" out="$2"
  shift 2
  curl -fsSL --max-time "$FETCH_TIMEOUT" -o "$out" "$@" --url "$url"
}

# fetch_source <ソース> <層> <URL> <保存先> [curl のオプション...]
# 取得できて中身があれば 0 を返す。取得に失敗したら error、空なら warn のエンベロープを出して 1 を返す（§3.2）。
fetch_source() {
  local source="$1" layer="$2" url="$3" out="$4" evidence message
  shift 4
  evidence="$(jq -nc --arg url "$url" '{url: $url}')"
  if ! message="$(fetch "$url" "$out" "$@" 2>&1)"; then
    envelope_error "$source" "$layer" "$evidence" "取得に失敗しました: ${message:-curl が失敗しました}"
    return 1
  fi
  if [ ! -s "$out" ]; then
    echo '[]' | envelope "$source" "$layer" warn 0 "$evidence" "応答が空でした"
    return 1
  fi
}

# run_source <ソース> <層> <関数> [引数...]
# 関数を set -e のサブシェルで実行する。途中で失敗したら出力を捨て、標準エラーの末尾を補足にした error のエンベロープを出す。
run_source() {
  local source="$1" layer="$2" out err rc message
  shift 2
  out="$(mktemp "$WORK_DIR/out.XXXXXX")"
  err="$(mktemp "$WORK_DIR/err.XXXXXX")"
  set +e
  (
    set -e
    "$@"
  ) >"$out" 2>"$err"
  rc=$?
  set -e
  if [ "$rc" -eq 0 ]; then
    cat "$out"
    return 0
  fi
  message="$(tail -n 5 "$err")"
  envelope_error "$source" "$layer" '{}' "処理に失敗しました（終了コード ${rc}）${message:+: $message}"
}

# ensure_inventory
# --inventory が無ければ、その場で inventory を実行して $INVENTORY_FILE に保存する（1 回の実行で 1 度だけ）。
ensure_inventory() {
  if [ -e "$INVENTORY_FILE" ]; then
    return 0
  fi
  cmd_inventory | jq -s . >"$INVENTORY_FILE.tmp"
  mv "$INVENTORY_FILE.tmp" "$INVENTORY_FILE"
}

# inventory_items [kind...]
# インベントリの項目を JSON 配列で出す。kind を指定すればその kind だけ。
inventory_items() {
  ensure_inventory || return 1
  jq -c '[.[] | select(.layer == "inventory") | .items[]
    | select(($ARGS.positional | length) == 0 or (.kind | IN($ARGS.positional[])))]' "$INVENTORY_FILE" --args -- "$@"
}

# --inventory FILE を読む（§3.4）。FILE は inventory の出力（エンベロープの配列）と同じ形
parse_inventory_option() {
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --inventory)
        [ "$#" -ge 2 ] || die "--inventory にファイルを指定してください"
        INVENTORY_FILE="$2"
        shift 2
        ;;
      *) die "不明な引数です: $1" ;;
    esac
  done
  if [ -z "$INVENTORY_FILE" ]; then
    return 0
  fi
  [ -r "$INVENTORY_FILE" ] || die "--inventory のファイルを読めません: $INVENTORY_FILE"
  jq -e 'type == "array"
    and all(.[]; type == "object" and (.items | type) == "array")
    and any(.[]; .layer == "inventory")' "$INVENTORY_FILE" >/dev/null 2>&1 ||
    die "--inventory のファイルが inventory の出力の形ではありません: $INVENTORY_FILE"
}

# version_parts <バージョン>
# 比較に使う「数字部分 プレリリースの接尾辞」を 1 行で出す（§7）。接尾辞が無ければ数字部分と空白だけ。
# 数字部分は . 区切りにし、各要素の先頭の 0 と末尾の .0 は落とす（1.0 と 1.0.0 を等しくする）。
# 例: 5.10.2 GM (b5299) → 5.10.2、77.1_1 → 77.1.1、2026-10-20 → 2026.10.20、2.0.0-rc.1 → 2 -rc.1
# 数字で始まらなければ 1 を返す。
version_parts() {
  local re='^[[:space:]]*[vV]?([0-9]+([._-][0-9]+)*)(-[A-Za-z][^[:space:]]*)?' part key="" pre
  [[ $1 =~ $re ]] || return 1
  pre="${BASH_REMATCH[3]:-}"
  for part in ${BASH_REMATCH[1]//[._-]/ }; do
    part="${part#"${part%%[!0]*}"}"
    key="$key.${part:-0}"
  done
  key="${key#.}"
  while [[ $key == *.0 ]]; do
    key="${key%.0}"
  done
  printf '%s %s\n' "$key" "$pre"
}

# version_compare <A> <B>
# A<B なら lt、等しければ eq、A>B なら gt を出す。数字部分が等しければプレリリースの側を小さいとする。
# 数字として解釈できないときと、接尾辞の異なるプレリリースどうし（1.2.3-alpha と 1.2.3-beta）はメッセージを出して 2 を返す。
version_compare() {
  local a b a_pre b_pre sorted
  a="$(version_parts "$1")" || {
    printf 'vulncheck: 数字として解釈できないバージョンです: %s\n' "$1" >&2
    return 2
  }
  b="$(version_parts "$2")" || {
    printf 'vulncheck: 数字として解釈できないバージョンです: %s\n' "$2" >&2
    return 2
  }
  a_pre="${a#* }" a="${a%% *}"
  b_pre="${b#* }" b="${b%% *}"
  if [ "$a" != "$b" ]; then
    sorted="$(printf '%s\n%s\n' "$a" "$b" | sort -V)"
    if [ "${sorted%%$'\n'*}" = "$a" ]; then
      echo lt
    else
      echo gt
    fi
  elif [ "$a_pre" = "$b_pre" ]; then
    echo eq
  elif [ -z "$a_pre" ]; then
    echo gt
  elif [ -z "$b_pre" ]; then
    echo lt
  else
    printf 'vulncheck: プレリリースどうしの順序は比べられません: %s と %s\n' "$1" "$2" >&2
    return 2
  fi
}

# --- inventory（§4） ---

# inventory_result <kind> <ok|warn> <evidence の JSON> [補足...]
# 標準入力の項目（JSON 配列）から inventory のエンベロープを出す。バージョン不明の項目があれば warn にする。
# 0 件は warn。ただし evidence に empty_reason（0 件を示すツールの出力の要点）があれば ok のまま（§4）。
inventory_result() {
  local kind="$1" status="$2" evidence="$3" items count unknown
  shift 3
  items="$(cat)"
  count="$(jq -e 'if type == "array" then length else error("項目が JSON 配列ではありません") end' <<<"$items")"
  unknown="$(jq -r '[.[] | select(.version == null) | .name] | join(", ")' <<<"$items")"
  if [ "$count" -eq 0 ] && ! jq -e 'has("empty_reason")' <<<"$evidence" >/dev/null; then
    status=warn
    set -- "$@" "0 件でした"
  fi
  if [ -n "$unknown" ]; then
    status=warn
    set -- "$@" "バージョン不明: $unknown"
  fi
  envelope "$kind" inventory "$status" "$count" "$evidence" "$@" <<<"$items"
}

# inventory_missing <kind> <コマンド>
# ツールが入っていない kind は ok + 0 件にする
inventory_missing() {
  echo '[]' | envelope "$1" inventory ok 0 "$(jq -nc --arg command "$2" '{command: $command}')" "未インストール（$2 が見つかりません）"
}

# with_empty_reason <evidence の JSON> <0 件を示す出力の要点>
# 0 件が正常であり得る kind（npm / pnpm / uv / vscode / brew-cask / ruby）で、ツールの出力が 0 件を示しているときに
# evidence に empty_reason を足す（inventory_result はこれがあれば 0 件でも ok にする）
with_empty_reason() {
  jq -c --arg reason "$2" '. + {empty_reason: $reason}' <<<"$1"
}

# brew が記録したインストール済みの formula と cask を $BREW_JSON に保存する（ローカル情報のみ。1 回の実行で 1 度だけ）
load_brew_installed() {
  if [ -s "$BREW_JSON" ]; then
    return 0
  fi
  HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew info --json=v2 --installed </dev/null >"$BREW_JSON.tmp" || return 1
  mv "$BREW_JSON.tmp" "$BREW_JSON"
}

# plist_get <plist> <キー>
# 値を出す。ファイルかキーが無ければ何も出さない。
plist_get() {
  "$PLIST_BUDDY" -c "Print :$2" "$1" 2>/dev/null || true
}

# 使っている keg（リンク中、無ければ最も新しいもの）のバージョン。revision（_1）も含む
inventory_brew_formula() {
  local cellar items
  if ! has_command brew; then
    inventory_missing brew-formula brew
    return 0
  fi
  load_brew_installed
  cellar="$(HOMEBREW_NO_AUTO_UPDATE=1 brew --cellar)"
  items="$(jq -c --arg cellar "$cellar" '[.formulae[]
    | (.linked_keg // (.installed | last | .version?)) as $version
    | {kind: "brew-formula", name: .name, version: $version, origin: .tap, bundle_id: null,
       path: (if $version then "\($cellar)/\(.name)/\($version)" else null end)}]' "$BREW_JSON")"
  inventory_result brew-formula ok '{"command":"brew info --json=v2 --installed"}' <<<"$items"
}

# .app もフォントも持たない cask（.app を持つ cask は app で扱う）
inventory_brew_cask() {
  local caskroom evidence items
  if ! has_command brew; then
    inventory_missing brew-cask brew
    return 0
  fi
  load_brew_installed
  caskroom="$(HOMEBREW_NO_AUTO_UPDATE=1 brew --caskroom)"
  evidence="$(jq -c '[.casks[] | [.artifacts[]? | objects | keys[]]] as $kinds
    | {command: "brew info --json=v2 --installed", casks: ($kinds | length),
       with_app: ([$kinds[] | select(index("app"))] | length),
       fonts: ([$kinds[] | select(index("font"))] | length)}' "$BREW_JSON")"
  items="$(jq -c --arg caskroom "$caskroom" '[.casks[]
    | select([.artifacts[]? | objects | keys[]] | index("app") or index("font") | not)
    | {kind: "brew-cask", name: .token, version: .installed, origin: .tap, bundle_id: null,
       path: (if .installed then "\($caskroom)/\(.token)/\(.installed)" else null end)}]' "$BREW_JSON")"
  if [ "$items" = "[]" ]; then
    evidence="$(with_empty_reason "$evidence" ".app もフォントも持たない cask が無い")"
  fi
  inventory_result brew-cask ok "$evidence" <<<"$items"
}

# /Applications/*.app。バージョンは brew の記録ではなく Info.plist から読む。Safari は macos で扱う
inventory_app() {
  local app plist name bundle_id version origin evidence found=0 status=ok cask_apps='[]' items="$WORK_DIR/app-items.jsonl"
  local notes=()
  if has_command brew; then
    if load_brew_installed 2>/dev/null; then
      cask_apps="$(jq -c '[.casks[] | .artifacts[]? | objects | select(has("app"))
        | (.app[] | if type == "string" then . else .target? end), .target? | strings | split("/") | last]' "$BREW_JSON")"
    else
      status=warn
      notes+=("brew の記録を読めず、origin の brew-cask を判定できませんでした")
    fi
  fi
  : >"$items"
  for app in "$APPS_DIR"/*.app; do
    [ -d "$app" ] || continue
    found=$((found + 1))
    plist="$app/Contents/Info.plist"
    name="$(basename "$app" .app)"
    bundle_id="$(plist_get "$plist" CFBundleIdentifier)"
    if [ "$bundle_id" = com.apple.Safari ]; then
      notes+=("Safari は macos で扱う")
      continue
    fi
    version="$(plist_get "$plist" CFBundleShortVersionString)"
    if [ -z "$version" ]; then
      version="$(plist_get "$plist" CFBundleVersion)"
      if [ -n "$version" ]; then
        # CFBundleVersion だけのアプリ（Steam など）は、それが製品のバージョンとは限らないので採らない
        notes+=("$name は CFBundleShortVersionString が無い（CFBundleVersion: ${version}）")
        version=""
      fi
    fi
    if [ -e "$app/Contents/_MASReceipt" ]; then
      origin=appstore
    elif jq -e --arg app "$name.app" 'index($app)' <<<"$cask_apps" >/dev/null; then
      origin=brew-cask
    elif [ -n "$(plist_get "$plist" SUFeedURL)" ]; then
      origin=sparkle
    else
      origin=other
    fi
    jq -nc --arg name "$name" --arg version "$version" --arg origin "$origin" --arg bundle_id "$bundle_id" --arg path "$app" \
      '{kind: "app", name: $name, version: ($version | select(. != "") // null), origin: $origin,
        bundle_id: ($bundle_id | select(. != "") // null), path: $path}' >>"$items"
  done
  evidence="$(jq -nc --arg dir "$APPS_DIR" --argjson found "$found" '{dir: $dir, apps: $found}')"
  jq -s -c . "$items" | inventory_result app "$status" "$evidence" ${notes[@]+"${notes[@]}"}
}

inventory_npm() {
  local out="$WORK_DIR/npm.json" rc=0 status=ok items evidence='{"command":"npm ls -g --json --depth=0"}'
  if ! has_command npm; then
    inventory_missing npm npm
    return 0
  fi
  npm ls -g --json --depth=0 </dev/null >"$out" || rc=$?
  jq -e 'type == "object" and (has("error") | not)' "$out" >/dev/null || die "npm ls -g の出力を読めません（終了コード ${rc}）"
  if [ "$rc" -ne 0 ]; then
    status=warn
    set -- "npm ls -g が終了コード $rc を返しました（一覧が不完全なおそれ）: $(jq -r '.problems // [] | join("; ")' "$out")"
  fi
  items="$(jq -c '[.dependencies // {} | to_entries[]
    | {kind: "npm", name: .key, version: (.value.version // null), origin: null, bundle_id: null, path: null}]' "$out")"
  if [ "$items" = "[]" ] && [ "$rc" -eq 0 ]; then
    evidence="$(with_empty_reason "$evidence" "dependencies が空")"
  fi
  inventory_result npm "$status" "$evidence" "$@" <<<"$items"
}

inventory_pnpm() {
  local out="$WORK_DIR/pnpm.json" items evidence='{"command":"pnpm ls -g --json"}'
  if ! has_command pnpm; then
    inventory_missing pnpm pnpm
    return 0
  fi
  pnpm ls -g --json </dev/null >"$out"
  items="$(jq -c '[.[] | (.dependencies // {}) + (.optionalDependencies // {}) + (.devDependencies // {}) | to_entries[]
    | {kind: "pnpm", name: .key, version: (.value.version // null), origin: null, bundle_id: null, path: null}]' "$out")"
  if [ "$items" = "[]" ]; then
    evidence="$(with_empty_reason "$evidence" "依存が無い: $(jq -c . "$out" | cut -c 1-200)")"
  fi
  inventory_result pnpm ok "$evidence" <<<"$items"
}

inventory_uv() {
  local out="$WORK_DIR/uv.txt" err="$WORK_DIR/uv.err" items evidence='{"command":"uv tool list"}'
  if ! has_command uv; then
    inventory_missing uv uv
    return 0
  fi
  uv tool list </dev/null >"$out" 2>"$err" || die "uv tool list が失敗しました: $(cat "$err")"
  # 「名前 v バージョン」の行を読み、続く「- 実行ファイル」の行は読み飛ばす
  items="$(jq -R -n -c '[inputs | select(length > 0 and (startswith("-") | not))
    | (capture("^(?<name>[^ ]+) v(?<version>[^ ]+)") // {name: ., version: null})
    | {kind: "uv", name, version, origin: null, bundle_id: null, path: null}]' "$out")"
  # 0 件のときは標準エラーに No tools installed と出る。出ないのに 0 件なら warn のまま
  if [ "$items" = "[]" ] && grep -q 'No tools installed' "$err"; then
    evidence="$(with_empty_reason "$evidence" "No tools installed")"
  elif [ -s "$err" ]; then
    set -- "uv tool list: $(head -n 1 "$err")"
  fi
  inventory_result uv ok "$evidence" "$@" <<<"$items"
}

# rbenv の各 Ruby で gem list。インストールされている版ごとに 1 項目、origin は Ruby のバージョン
inventory_gem() {
  local rubies ruby evidence status=ok out="$WORK_DIR/gem.txt" items="$WORK_DIR/gem-items.jsonl"
  local notes=()
  if ! has_command rbenv; then
    inventory_missing gem rbenv
    return 0
  fi
  rubies="$(rbenv versions --bare </dev/null)"
  : >"$items"
  while IFS= read -r ruby; do
    [ -n "$ruby" ] || continue
    if ! RBENV_VERSION="$ruby" rbenv exec gem list --local </dev/null >"$out" 2>&1; then
      status=warn
      notes+=("Ruby $ruby の gem list が失敗しました: $(tail -n 1 "$out")")
      continue
    fi
    # 例: nokogiri (1.18.7 arm64-darwin, 1.16.0)、csv (3.3.7, default: 3.2.8 ruby)
    jq -R -n -c --arg origin "rbenv $ruby" '[inputs | select(length > 0 and (startswith("***") | not))
      | (capture("^(?<name>[^ ]+) \\((?<versions>.*)\\)$") // {name: ., versions: null})
      | .name as $name
      | if .versions then .versions | split(", ")[] | sub("^default: "; "") | split(" ")[0] else null end
      | {kind: "gem", name: $name, version: ., origin: $origin, bundle_id: null, path: null}] | unique' "$out" >>"$items"
  done <<<"$rubies"
  evidence="$(jq -s -c '{command: "gem list --local", rubies: length, gems: (add // [] | map(.name) | unique | length)}' "$items")"
  jq -s -c 'add // []' "$items" | inventory_result gem "$status" "$evidence" ${notes[@]+"${notes[@]}"}
}

# macOS 本体と Safari（Safari は macOS に含めて扱う）
inventory_macos() {
  local version build extra safari evidence
  version="$(sw_vers -productVersion)"
  build="$(sw_vers -buildVersion)"
  extra="$(sw_vers -productVersionExtra 2>/dev/null || true)"
  safari="$(plist_get "$APPS_DIR/Safari.app/Contents/Info.plist" CFBundleShortVersionString)"
  evidence="$(jq -nc --arg build "$build" --arg extra "$extra" \
    '{command: "sw_vers", build: $build, extra: ($extra | select(. != "") // null)}')"
  jq -n -c --arg version "$version" --arg safari "$safari" --arg path "$APPS_DIR/Safari.app" \
    '[{kind: "macos", name: "macOS", version: $version, origin: null, bundle_id: null, path: null},
      {kind: "macos", name: "Safari", version: ($safari | select(. != "") // null), origin: null,
       bundle_id: "com.apple.Safari", path: $path}]' |
    inventory_result macos ok "$evidence"
}

# rbenv の Ruby 本体。jruby-9.4.0.0 のような名前は名前とバージョンに分ける
inventory_ruby() {
  local root items evidence='{"command":"rbenv versions --bare"}'
  if ! has_command rbenv; then
    inventory_missing ruby rbenv
    return 0
  fi
  root="$(rbenv root)"
  items="$(rbenv versions --bare </dev/null |
    jq -R -n -c --arg root "$root" '[inputs | select(length > 0)
      | (capture("^(?<name>[a-z][a-z-]*?)-(?<version>[0-9].*)$") // {name: "ruby", version: .}) + {dir: .}
      | {kind: "ruby", name, version, origin: "rbenv", bundle_id: null, path: "\($root)/versions/\(.dir)"}]')"
  if [ "$items" = "[]" ]; then
    evidence="$(with_empty_reason "$evidence" "出力が空（終了コード 0）")"
  fi
  inventory_result ruby ok "$evidence" <<<"$items"
}

# PATH に code が無ければ .app の中のものを使う
inventory_vscode() {
  local code items evidence
  if has_command code; then
    code="$(command -v code)"
  elif [ -x "$VSCODE_APP_CLI" ]; then
    code="$VSCODE_APP_CLI"
  else
    inventory_missing vscode code
    return 0
  fi
  items="$("$code" --list-extensions --show-versions </dev/null |
    jq -R -n -c '[inputs | select(length > 0)
      | (capture("^(?<name>[^@ ]+)@(?<version>[^ ]+)$") // {name: ., version: null})
      | {kind: "vscode", name, version, origin: null, bundle_id: null, path: null}]')"
  evidence="$(jq -nc --arg command "$code --list-extensions --show-versions" '{command: $command}')"
  if [ "$items" = "[]" ]; then
    evidence="$(with_empty_reason "$evidence" "出力が空（終了コード 0）")"
  fi
  inventory_result vscode ok "$evidence" <<<"$items"
}

cmd_inventory() {
  local kind
  for kind in brew-formula brew-cask app npm pnpm uv gem macos ruby vscode; do
    run_source "$kind" inventory "inventory_${kind//-/_}"
  done
}

# --- 層2（§5） ---
# OSV_URL / BREW_FORMULA_URL / EOL_URL はベース URL。file:// のときもその下の同じパス
# （v1/querybatch、v1/vulns/<id>、<formula>.json、ruby.json）を読む。

OSV_BATCH=1000

# fetch_many <リスト> [curl のオプション...]
# リストの各行「URL<TAB>保存先」を並列に取得する。1 件が失敗しても残りは取得する。
# 1 件ごとに「保存先<TAB>curl の終了コード<TAB>HTTP の状態コード<TAB>エラー」を出す（順不同）。
# HTTP/2 の 404 は終了コードが 22 ではなく 56 になるので、404 かどうかは状態コードで見る。
# curl が結果を出さなかったものは終了コード -1 にする。
fetch_many() {
  local list="$1" report url out
  local args=()
  shift
  while IFS=$'\t' read -r url out; do
    args+=(-o "$out" --url "$url")
  done <"$list"
  if [ "${#args[@]}" -eq 0 ]; then
    return 0
  fi
  report="$(mktemp "$WORK_DIR/fetch.XXXXXX")"
  curl -fsSL --parallel --parallel-max 8 --max-time "$FETCH_TIMEOUT" \
    -w '%{filename_effective}\t%{exitcode}\t%{response_code}\t%{errormsg}\n' "$@" "${args[@]}" >"$report" 2>/dev/null || true
  awk -F '\t' 'NR == FNR { seen[$1] = 1; print; next } !($2 in seen) { print $2 "\t-1\t000\tcurl が結果を出しませんでした" }' \
    "$report" "$list"
}

# inventory_notes <kind...>
# 指定した kind のインベントリが取得失敗か、0 件で要確認なら、その旨の補足を 1 行ずつ出す。
# 照合の対象から漏れているおそれがあるので、呼び出し側は warn にする。
inventory_notes() {
  ensure_inventory || return 1
  jq -r '.[] | select(.layer == "inventory" and (.source | IN($ARGS.positional[])))
    | if .status == "error" then "インベントリの \(.source) を取得できなかったため照合していません"
      elif .status == "warn" and .count == 0 then "インベントリの \(.source) が 0 件（要確認）のため照合していません"
      else empty end' "$INVENTORY_FILE" --args -- "$@"
}

# OSV の CVSS v3 のベクターから基本値を計算する jq の定義（OSV はベクターしか返さない）。v4 などは null
# shellcheck disable=SC2016 # $ は jq の変数
CVSS3_JQ='
  def roundup: (. * 100000 | round) as $i
    | if $i % 10000 == 0 then $i / 100000 else (($i / 10000 | floor) + 1) / 10 end;
  def cvss3:
    (split("/")[1:] | map(split(":") | {key: .[0], value: .[1]}) | from_entries) as $m
    | ($m.S == "C") as $changed
    | ({N: 0.85, A: 0.62, L: 0.55, P: 0.2}[$m.AV // ""]) as $av
    | ({L: 0.77, H: 0.44}[$m.AC // ""]) as $ac
    | ((if $changed then {N: 0.85, L: 0.68, H: 0.5} else {N: 0.85, L: 0.62, H: 0.27} end)[$m.PR // ""]) as $pr
    | ({N: 0.85, R: 0.62}[$m.UI // ""]) as $ui
    | ([$m.C, $m.I, $m.A] | map({H: 0.56, L: 0.22, N: 0}[. // ""])) as $cia
    | if ([$av, $ac, $pr, $ui] + $cia | any(. == null)) or ($m.S | IN("U", "C") | not) then null
      else (1 - (1 - $cia[0]) * (1 - $cia[1]) * (1 - $cia[2])) as $iss
      | (if $changed then 7.52 * ($iss - 0.029) - 3.25 * pow($iss - 0.02; 15) else 6.42 * $iss end) as $impact
      | if $impact <= 0 then 0
        else [($impact + 8.22 * $av * $ac * $pr * $ui) * (if $changed then 1.08 else 1 end), 10] | min | roundup end
      end;
  def cvss_score:
    if type == "string" and startswith("CVSS:3") then cvss3 else null end;
'

# npm / pnpm / uv / gem の全件を OSV の querybatch で照合し、該当した脆弱性の詳細を /v1/vulns/<id> で取る（§5.1）。
# 項目は「パッケージ × 脆弱性」ごと。詳細を取れなかった脆弱性も id だけで項目に残し、warn にする
layer2_osv() {
  local all="$WORK_DIR/osv-all.json" packages="$WORK_DIR/osv-packages.json" query="$WORK_DIR/osv-query.json"
  local batch="$WORK_DIR/osv-batch.json" results="$WORK_DIR/osv-results.jsonl" matches="$WORK_DIR/osv-matches.json"
  local ids="$WORK_DIR/osv-ids.json" list="$WORK_DIR/osv-vulns.tsv" report="$WORK_DIR/osv-report.tsv"
  local details="$WORK_DIR/osv-details.json" text note total i n evidence status=ok file rc
  local notes=() files=()
  ensure_inventory
  text="$(inventory_notes npm pnpm uv gem)"
  while IFS= read -r note; do
    if [ -n "$note" ]; then
      status=warn
      notes+=("$note")
    fi
  done <<<"$text"
  inventory_items npm pnpm uv gem |
    jq -c 'map(. + {ecosystem: {npm: "npm", pnpm: "npm", uv: "PyPI", gem: "RubyGems"}[.kind]})' >"$all"
  text="$(jq -r '[.[] | select(.version == null) | "\(.kind) \(.name)"] | join(", ")' "$all")"
  if [ -n "$text" ]; then
    status=warn
    notes+=("バージョン不明のため照合していません: $text")
  fi
  jq -c 'map(select(.version != null))' "$all" >"$packages"
  total="$(jq length "$packages")"
  : >"$results"
  for ((i = 0; i < total; i += OSV_BATCH)); do
    jq -c --argjson i "$i" --argjson n "$OSV_BATCH" '{queries: [.[$i:$i + $n][] | {package: {name, ecosystem}, version}]}' \
      "$packages" >"$query"
    fetch_source osv layer2 "$OSV_URL/v1/querybatch" "$batch" \
      -H 'Content-Type: application/json' --data-binary "@$query" || return 0
    n="$(jq '.queries | length' "$query")"
    jq -c --argjson n "$n" 'if (.results | type) == "array" and (.results | length) == $n then .results[]
      else error("OSV の応答の件数が問い合わせ（\($n) 件）と合いません") end' "$batch" >>"$results"
  done
  jq -s -c --slurpfile packages "$packages" '[to_entries[] | select((.value.vulns // []) | length > 0)
    | {package: $packages[0][.key], ids: [.value.vulns[].id], more: (.value.next_page_token != null)}]' "$results" >"$matches"
  text="$(jq -r '[.[] | select(.more) | .package.name] | join(", ")' "$matches")"
  if [ -n "$text" ]; then
    status=warn
    notes+=("該当が多く、一部しか取得できていません: $text")
  fi
  jq -c '[.[].ids[]] | unique' "$matches" >"$ids"
  jq -r --arg url "$OSV_URL" --arg dir "$WORK_DIR" 'to_entries[] | "\($url)/v1/vulns/\(.value)\t\($dir)/osv-vuln-\(.key).json"' \
    "$ids" >"$list"
  fetch_many "$list" >"$report"
  while IFS=$'\t' read -r file rc _; do
    if [ "$rc" = 0 ] && [ -s "$file" ]; then
      files+=("$file")
    fi
  done <"$report"
  # 詳細は「保存先 → 要点」の JSON にする（affected はパッケージと修正版だけ残す）
  jq -n -c "$CVSS3_JQ"'[inputs | {key: input_filename, value: {
      aliases: (.aliases // []),
      summary: (.summary // (.details // "" | split("\n")[0] | .[:200] | select(. != "")) // null),
      severity: [.severity[]? | {type, score: (.score | cvss_score), vector: .score}],
      rating: (.database_specific.severity? // null),
      affected: [.affected[]? | {package, fixed: [.ranges[]?.events[]? | .fixed? // empty]}]}}] | from_entries' \
    ${files[@]+"${files[@]}"} </dev/null >"$details"
  text="$(jq -r --slurpfile details "$details" --arg dir "$WORK_DIR" \
    '[to_entries[] | select($details[0]["\($dir)/osv-vuln-\(.key).json"] == null) | .value] | join(", ")' "$ids")"
  if [ -n "$text" ]; then
    status=warn
    notes+=("詳細を取得できませんでした（id のみ）: $text")
  fi
  evidence="$(jq -c --arg url "$OSV_URL/v1/querybatch" --argjson queried "$total" \
    '{url: $url, queried: $queried, vulnerable_packages: length, vulns: ([.[].ids[]] | unique | length)}' "$matches")"
  if [ "$total" -eq 0 ] && [ "$status" = ok ]; then
    notes+=("照合する言語パッケージがありません")
  fi
  jq -c --slurpfile details "$details" --slurpfile ids "$ids" --arg dir "$WORK_DIR" '
    def norm($ecosystem): if $ecosystem == "PyPI" then ascii_downcase | gsub("[-_.]+"; "-") else . end;
    def version_key: [splits("[^0-9A-Za-z]+")] | map(tonumber? // .);
    ($ids[0] | to_entries | map({key: .value, value: $details[0]["\($dir)/osv-vuln-\(.key).json"]}) | from_entries) as $by_id
    | [.[] | .package as $p | .ids[] | . as $id | $by_id[$id] as $d
      | {kind: $p.kind, name: $p.name, version: $p.version, ecosystem: $p.ecosystem, origin: $p.origin, id: $id,
         aliases: ($d.aliases // []), summary: ($d.summary // null), severity: ($d.severity // []), rating: ($d.rating // null),
         fixed: ([$d.affected[]? | select(.package.ecosystem == $p.ecosystem
                   and (.package.name | norm($p.ecosystem)) == ($p.name | norm($p.ecosystem))) | .fixed[]]
                 | unique | sort_by(version_key))}]' "$matches" >"$WORK_DIR/osv-items.json"
  text="$(jq -r '[.[] | select(any(.severity[]; .score == null and (.vector | tostring | startswith("CVSS:")))
    and all(.severity[]; .score == null)) | .id] | unique | length' "$WORK_DIR/osv-items.json")"
  if [ "$text" -gt 0 ]; then
    notes+=("CVSS v4 などスコアを計算していない脆弱性が ${text} 件（severity はベクターのみ）")
  fi
  envelope osv layer2 "$status" "$total" "$evidence" ${notes[@]+"${notes[@]}"} <"$WORK_DIR/osv-items.json"
}

cmd_osv() {
  run_source osv layer2 layer2_osv
}

# latest_result <ソース> <状態> <件数> <evidence の JSON> [補足...]
# 標準入力の項目（JSON 配列）の installed と latest を version_compare で比べて outdated を入れ、エンベロープを出す。
# outdated が既にある項目（softwareupdate）は比べない。対応付けできない、バージョン不明、比べられない項目があれば
# warn にして補足に名前を書く（§5.2）。evidence には照合した件数と outdated、unmapped の件数を足す。
latest_result() {
  local source="$1" status="$2" count="$3" evidence="$4" items mode installed latest result outdated="" text
  shift 4
  items="$(cat)"
  # 区切りは空白でない文字（\x1f）にする。タブだと空の欄が詰められる
  while IFS=$'\x1f' read -r mode installed latest; do
    if [ "$mode" = preset ]; then
      result='"preset"'
    elif [ -z "$installed" ] || [ -z "$latest" ]; then
      result=null
    elif result="$(version_compare "$installed" "$latest" 2>/dev/null)"; then
      if [ "$result" = lt ]; then
        result=true
      else
        result=false
      fi
    else
      result=null
    fi
    outdated="$outdated${outdated:+,}$result"
  done < <(jq -r '.[] | [(if has("outdated") then "preset" else "compare" end), .installed // "", .latest // ""] | join("\u001f")' <<<"$items")
  items="$(jq -c --argjson outdated "[$outdated]" 'to_entries | map(.value as $v
    | {kind: $v.kind, name: $v.name, installed: $v.installed, latest: $v.latest,
       outdated: (if $outdated[.key] == "preset" then $v.outdated else $outdated[.key] end),
       method: $v.method, eol: $v.eol, update_command: $v.update_command, matched: $v.matched})' <<<"$items")"
  text="$(jq -r '[.[] | select(.method == "unmapped") | "\(.name) \(.installed // "（バージョン不明）")"] | join(", ")' <<<"$items")"
  if [ -n "$text" ]; then
    status=warn
    set -- "$@" "対応付けできませんでした（unmapped）: $text"
  fi
  text="$(jq -r '[.[] | select(.installed == null) | .name] | join(", ")' <<<"$items")"
  if [ -n "$text" ]; then
    status=warn
    set -- "$@" "インストール済みのバージョンが不明: $text"
  fi
  text="$(jq -r '[.[] | select(.installed != null and .latest != null and .outdated == null)
    | "\(.name)（\(.installed) と \(.latest)）"] | join(", ")' <<<"$items")"
  if [ -n "$text" ]; then
    status=warn
    set -- "$@" "バージョンを比べられませんでした: $text"
  fi
  if [ "$items" = "[]" ]; then
    set -- "$@" "照合する項目がありません"
  fi
  evidence="$(jq -c --argjson items "$items" '. + {checked: ($items | length),
    outdated: ([$items[] | select(.outdated == true)] | length),
    unmapped: ([$items[] | select(.method == "unmapped")] | length)}' <<<"$evidence")"
  envelope "$source" layer2 "$status" "$count" "$evidence" "$@" <<<"$items"
}

# brew-formula の最新版を formulae.brew.sh の formula API から取る（ローカルの brew キャッシュは使わない）。
# homebrew/core 以外の tap と 404 は unmapped。全件 404 なら URL の誤りとして、404 以外の失敗は 1 件でも error にする
latest_brew_formula() {
  local formulae="$WORK_DIR/formulae.json" list="$WORK_DIR/formulae.tsv" report="$WORK_DIR/formulae-report.tsv"
  local fetched="$WORK_DIR/formulae-fetched.json" api="$WORK_DIR/formulae-api.json" text note file rc status=ok evidence
  local notes=() files=()
  ensure_inventory
  text="$(inventory_notes brew-formula)"
  while IFS= read -r note; do
    if [ -n "$note" ]; then
      status=warn
      notes+=("$note")
    fi
  done <<<"$text"
  inventory_items brew-formula | jq -c --arg dir "$WORK_DIR" 'to_entries | map(.value + {file: "\($dir)/formula-\(.key).json"})' >"$formulae"
  jq -r --arg url "$BREW_FORMULA_URL" '.[] | select(.origin == "homebrew/core") | "\($url)/\(.name).json\t\(.file)"' \
    "$formulae" >"$list"
  fetch_many "$list" >"$report"
  # formula ごとの取得結果 {rc, code, error} を足す（取得しなかった tap のものは null）
  jq -R -n -c --slurpfile formulae "$formulae" '[inputs | split("\t") | select(length > 2)
    | {key: .[0], value: {rc: .[1], code: .[2], error: (.[3] // "")}}] | from_entries as $r
    | $formulae[0] | map(. + {fetch: $r[.file]})' "$report" >"$fetched"
  evidence="$(jq -nc --arg url "$BREW_FORMULA_URL/<formula>.json" '{url: $url}')"
  text="$(jq -r '[.[] | select(.fetch != null and .fetch.rc != "0" and .fetch.code != "404")
    | "\(.name): \(.fetch.error)（curl \(.fetch.rc)）"] | .[:3] | join("; ")' "$fetched")"
  if [ -n "$text" ]; then
    envelope_error brew-api layer2 "$evidence" "取得に失敗しました: $text"
    return 0
  fi
  if jq -e '[.[] | select(.fetch != null) | .fetch.code] | length > 0 and all(. == "404")' "$fetched" >/dev/null; then
    envelope_error brew-api layer2 "$evidence" "すべての formula が 404 でした（URL の誤り）"
    return 0
  fi
  while IFS=$'\t' read -r file rc _; do
    if [ "$rc" = 0 ] && [ -s "$file" ]; then
      files+=("$file")
    fi
  done <"$report"
  jq -n -c '[inputs | {key: input_filename, value: (if .versions.stable
    then .versions.stable + (if (.revision // 0) > 0 then "_\(.revision)" else "" end) else null end)}] | from_entries' \
    ${files[@]+"${files[@]}"} </dev/null >"$api"
  text="$(jq -r --slurpfile api "$api" '[.[] | select(.fetch != null and .fetch.code != "404" and $api[0][.file] == null)
    | .name] | join(", ")' "$fetched")"
  if [ -n "$text" ]; then
    status=warn
    notes+=("応答が空か、最新版を読めませんでした: $text")
  fi
  text="$(jq -r '[.[] | select(.fetch.code? == "404") | .name] | join(", ")' "$fetched")"
  if [ -n "$text" ]; then
    notes+=("formula API に無い（404）: $text")
  fi
  text="$(jq -r '[.[] | select(.origin != "homebrew/core") | "\(.name)（\(.origin)）"] | join(", ")' "$formulae")"
  if [ -n "$text" ]; then
    notes+=("homebrew/core 以外の tap は formula API に無い: $text")
  fi
  jq -c --slurpfile api "$api" 'map($api[0][.file] as $latest
    | {kind, name, installed: .version, latest: $latest, method: (if $latest then "brew-api" else "unmapped" end), eol: null,
       update_command: "brew upgrade \(.name)", matched: (if $latest then .name else null end)})' "$formulae" |
    latest_result brew-api "$status" "$(jq length "$api")" "$evidence" ${notes[@]+"${notes[@]}"}
}

# .app の無い brew-cask と、App Store 以外の app の最新版を cask API から取る。
# app は .app 名で cask を対応付ける（brew で入れたかは問わない）。brew で入れたものは brew の記録の cask を優先し、
# それ以外で候補が複数なら、非推奨でないもの、@ の無いもの（beta などでないもの）、名前の短いものの順に選ぶ
latest_cask() {
  local casks="$WORK_DIR/cask.json" targets="$WORK_DIR/cask-targets.json" results="$WORK_DIR/cask-results.json"
  local url="$BREW_CASK_URL" installed='{}' text note count=0 status=ok evidence
  local notes=()
  ensure_inventory
  text="$(inventory_notes brew-cask app)"
  while IFS= read -r note; do
    if [ -n "$note" ]; then
      status=warn
      notes+=("$note")
    fi
  done <<<"$text"
  inventory_items brew-cask app | jq -c 'map(select(.kind == "brew-cask" or .origin != "appstore"))' >"$targets"
  evidence="$(jq -nc --arg url "$url" '{url: $url}')"
  if [ "$(jq length "$targets")" -eq 0 ]; then
    latest_result cask-api "$status" 0 "$evidence" ${notes[@]+"${notes[@]}"} <"$targets"
    return 0
  fi
  if has_command brew; then
    if load_brew_installed 2>/dev/null; then
      # brew で入れた cask の「.app 名 → cask」
      installed="$(jq -c '[.casks[] | .token as $token | .artifacts[]? | objects | select(has("app")) | .app
        | ((map(objects | .target? | strings) | first) // (map(strings) | first)) | strings
        | {key: (split("/") | last), value: $token}] | from_entries' "$BREW_JSON")"
    else
      status=warn
      notes+=("brew の記録を読めず、brew で入れた cask を優先できませんでした")
    fi
  fi
  fetch_source cask-api layer2 "$url" "$casks" --compressed || return 0
  count="$(jq -e 'if type == "array" then length else error("cask API の応答が配列ではありません") end' "$casks")"
  evidence="$(jq -c --argjson count "$count" '. + {casks: $count}' <<<"$evidence")"
  jq -c --slurpfile targets "$targets" --argjson installed "$installed" '
    def app_names: [.artifacts[]? | objects | select(has("app")) | .app
      | ((map(objects | .target? | strings) | first) // (map(strings) | first)) | strings | split("/") | last];
    map({token, version: (((.version // "") | tostring | split(",")[0] | select(. != "")) // null),
         skip: (.deprecated == true or .disabled == true), apps: app_names}) as $casks
    | (INDEX($casks[]; .token)) as $by_token
    | (reduce ($casks[] | . as $c | .apps[] | {app: ., cask: $c}) as $e ({}; .[$e.app] += [$e.cask])) as $by_app
    | [$targets[0][] | . as $t
      | if $t.kind == "brew-cask" then
          $by_token[$t.name] as $c
          | {item: {kind, name, installed: .version, latest: $c.version, method: (if $c.version then "cask-api" else "unmapped" end),
                    eol: null, update_command: "brew upgrade --cask \($t.name)", matched: $c.token}, note: null}
        else
          ($by_app["\($t.name).app"] // []) as $candidates
          | $installed["\($t.name).app"] as $brew_token
          | (if $t.origin == "brew-cask" and ($candidates | any(.token == $brew_token))
             then ($candidates | map(select(.token == $brew_token)) | first)
             else ($candidates | sort_by([.skip, (.token | contains("@")), (.token | length), .token]) | first) end) as $c
          | ($brew_token // $c.token) as $upgrade
          | {item: {kind, name, installed: .version, latest: $c.version, method: (if $c.version then "cask-api" else "unmapped" end),
                    eol: null,
                    update_command: (if $t.origin == "brew-cask" and $upgrade then "brew upgrade --cask \($upgrade)" else "アプリ内の更新" end),
                    matched: $c.token},
             note: (if ($candidates | length) > 1
                    then "\($t.name).app に対応する cask が複数: \($candidates | map(.token) | join(", "))（\($c.token) を採用）"
                    else null end)}
        end]' "$casks" >"$results"
  text="$(jq -r '.[] | .note | strings' "$results")"
  while IFS= read -r note; do
    if [ -n "$note" ]; then
      notes+=("$note")
    fi
  done <<<"$text"
  jq -c 'map(.item)' "$results" | latest_result cask-api "$status" "$count" "$evidence" ${notes[@]+"${notes[@]}"}
}

# App Store のアプリは iTunes Lookup API で bundle id から引く（Mac 版だけを採る）
latest_itunes() {
  local targets="$WORK_DIR/itunes-targets.json" out="$WORK_DIR/itunes.json" url text note count status=ok evidence
  local notes=()
  ensure_inventory
  text="$(inventory_notes app)"
  while IFS= read -r note; do
    if [ -n "$note" ]; then
      status=warn
      notes+=("$note")
    fi
  done <<<"$text"
  inventory_items app | jq -c 'map(select(.origin == "appstore"))' >"$targets"
  url="$ITUNES_URL?entity=macSoftware&bundleId=$(jq -r '[.[].bundle_id | strings | @uri] | join(",")' "$targets")"
  evidence="$(jq -nc --arg url "$url" '{url: $url}')"
  if [ "$(jq length "$targets")" -eq 0 ]; then
    latest_result itunes "$status" 0 "$evidence" ${notes[@]+"${notes[@]}"} <"$targets"
    return 0
  fi
  fetch_source itunes layer2 "$url" "$out" || return 0
  count="$(jq -e '.results | if type == "array" then length else error("iTunes Lookup の応答に results がありません") end' "$out")"
  if [ "$count" -eq 0 ]; then
    status=warn
    notes+=("0 件でした")
  fi
  jq -c --slurpfile lookup "$out" '
    ($lookup[0].results | map(select(.kind == "mac-software") | {key: (.bundleId | ascii_downcase), value: .version}) | from_entries) as $versions
    | map($versions[.bundle_id // "" | ascii_downcase] as $latest
      | {kind, name, installed: .version, latest: $latest, method: (if $latest then "itunes" else "unmapped" end), eol: null,
         update_command: "App Store", matched: (if $latest then .bundle_id else null end)})' "$targets" |
    latest_result itunes "$status" "$count" "$evidence" ${notes[@]+"${notes[@]}"}
}

# macOS 本体と Safari は softwareupdate --list に更新が出ているかで判定する（Safari だけの更新もある）。
# 出ていれば outdated: true で、latest はその版（同じメジャーの更新を優先）。出ていなければ latest はインストール済みの版
latest_softwareupdate() {
  local out="$WORK_DIR/softwareupdate.txt" err="$WORK_DIR/softwareupdate.err" entries text note status=ok evidence parsed=true
  local notes=()
  ensure_inventory
  text="$(inventory_notes macos)"
  while IFS= read -r note; do
    if [ -n "$note" ]; then
      status=warn
      notes+=("$note")
    fi
  done <<<"$text"
  softwareupdate --list </dev/null >"$out" 2>"$err" || die "softwareupdate --list が失敗しました: $(tail -n 3 "$err")"
  # 例: * Label: macOS Tahoe 27.2.1-26C123
  #     	Title: macOS Tahoe 27.2.1, Version: 27.2.1, Size: 1234567KiB, Recommended: YES, Action: restart,
  entries="$(jq -R -n -c 'reduce (inputs | capture("^\\* Label: (?<label>.+)$") // capture("^\\s+Title: (?<title>.*?), Version: (?<version>[^,]+)") // empty) as $line
    ([]; if $line.label then . + [$line] elif length > 0 then .[-1] += $line else . end)' "$out")"
  evidence="$(jq -nc --argjson updates "$entries" --arg message "$(cat "$out" "$err" | grep -m 1 'No new software available' || true)" \
    '{command: "softwareupdate --list", updates: $updates, message: ($message | select(. != "") // null)}')"
  if [ "$entries" = "[]" ] && ! grep -q 'No new software available' "$out" "$err"; then
    status=warn
    parsed=false
    notes+=("softwareupdate --list の出力を解釈できませんでした: $(cat "$out" "$err" | tr '\n' ' ' | cut -c 1-200)")
  fi
  # 解釈できなかったときは更新の有無が分からないので latest と outdated を null にする
  inventory_items macos | jq -c --argjson updates "$entries" --argjson parsed "$parsed" '
    def version_key: [splits("[^0-9]+")] | map(tonumber? // 0);
    if $parsed | not then map({kind, name, installed: .version, latest: null, outdated: null, method: "softwareupdate", eol: null,
      update_command: "システム設定 > 一般 > ソフトウェアアップデート", matched: null}) else
    map(. as $t
      | [$updates[] | select(.version != null and (.title // "" | test(if $t.name == "Safari" then "^Safari" else "^macOS" end)))] as $candidates
      | [$candidates[] | select((.version | split(".")[0]) == (($t.version // "") | split(".")[0]))] as $same_major
      | (if ($same_major | length) > 0 then $same_major else $candidates end | sort_by(.version | version_key) | last) as $update
      | {kind, name, installed: .version, latest: ($update.version // .version), outdated: ($update != null),
         method: "softwareupdate", eol: null,
         update_command: (if $update then "softwareupdate --install \"\($update.label)\"" else "システム設定 > 一般 > ソフトウェアアップデート" end),
         matched: $update.label}) end' |
    latest_result softwareupdate "$status" "$(jq length <<<"$entries")" "$evidence" ${notes[@]+"${notes[@]}"}
}

# rbenv の Ruby は endoflife.date で同じサイクル（3.3 など）の最新パッチと EOL を取る。ruby 以外（jruby など）は unmapped
latest_endoflife() {
  local targets="$WORK_DIR/eol-targets.json" out="$WORK_DIR/eol-ruby.json" url="$EOL_URL/ruby.json" text note count=0 today status=ok evidence
  local notes=()
  ensure_inventory
  text="$(inventory_notes ruby)"
  while IFS= read -r note; do
    if [ -n "$note" ]; then
      status=warn
      notes+=("$note")
    fi
  done <<<"$text"
  inventory_items ruby >"$targets"
  evidence="$(jq -nc --arg url "$url" '{url: $url}')"
  if jq -e 'any(.[]; .name == "ruby")' "$targets" >/dev/null; then
    fetch_source endoflife layer2 "$url" "$out" || return 0
  else
    echo '[]' >"$out"
  fi
  count="$(jq -e 'if type == "array" then length else error("endoflife.date の応答が配列ではありません") end' "$out")"
  if [ "$count" -eq 0 ] && [ "$(jq length "$targets")" -gt 0 ]; then
    status=warn
    notes+=("0 件でした")
  fi
  evidence="$(jq -c --argjson count "$count" '. + {cycles: $count}' <<<"$evidence")"
  today="$(now_iso)"
  today="${today%%T*}"
  jq -c --slurpfile cycles "$out" 'map((((.version // "") | capture("^(?<cycle>[0-9]+\\.[0-9]+)") | .cycle) // null) as $cycle
    | (if .name == "ruby" then first($cycles[0][] | select(.cycle == $cycle)) // null else null end) as $c
    | if $c then
        {kind, name, installed: .version, latest: $c.latest, method: "endoflife", eol: $c.eol,
         update_command: "rbenv install \($c.latest)", matched: $cycle}
      else
        {kind, name, installed: .version, latest: null, method: "unmapped", eol: null, update_command: null, matched: null}
      end)' "$targets" >"$WORK_DIR/eol-items.json"
  text="$(jq -r --arg today "$today" '[.[] | select(.eol == true or (.eol | type) == "string" and .eol <= $today)
    | "\(.name) \(.installed)（EOL \(.eol)）"] | join(", ")' "$WORK_DIR/eol-items.json")"
  if [ -n "$text" ]; then
    notes+=("EOL を過ぎています: $text")
  fi
  latest_result endoflife "$status" "$count" "$evidence" ${notes[@]+"${notes[@]}"} <"$WORK_DIR/eol-items.json"
}

cmd_latest() {
  run_source brew-api layer2 latest_brew_formula
  run_source cask-api layer2 latest_cask
  run_source itunes layer2 latest_itunes
  run_source softwareupdate layer2 latest_softwareupdate
  run_source endoflife layer2 latest_endoflife
}

# 削除済み一覧（Markdown の表「| 拡張 ID | 削除日 | 種別 |」）を読み、インストール済みの拡張と大文字小文字を区別せずに照合する（§5.3）
layer2_vscode() {
  local removed="$WORK_DIR/vscode-removed.md" list="$WORK_DIR/vscode-removed.json" text note count status=ok evidence
  local notes=()
  ensure_inventory
  text="$(inventory_notes vscode)"
  while IFS= read -r note; do
    if [ -n "$note" ]; then
      status=warn
      notes+=("$note")
    fi
  done <<<"$text"
  fetch_source vscode layer2 "$VSCODE_REMOVED_URL" "$removed" --compressed || return 0
  # 末尾の | が無い行もある。削除日（11/5/2026）は 2026-11-05 にする
  jq -R -n -c '[inputs | select(startswith("|")) | ltrimstr("|") | split("|") | map(gsub("^\\s+|\\s+$"; ""))
    | select(length >= 2 and .[0] != "" and .[0] != "Extension Identifier" and (.[0] | test("^:?-+:?$") | not))
    | {id: .[0],
       removal_date: (.[1] | (capture("^(?<m>[0-9]{1,2})/(?<d>[0-9]{1,2})/(?<y>[0-9]{4})$")
         | "\(.y)-\(.m | if length < 2 then "0" + . else . end)-\(.d | if length < 2 then "0" + . else . end)") // .),
       type: ((.[2] // "") | if . == "" then null else . end)}]' "$removed" >"$list"
  count="$(jq length "$list")"
  if [ "$count" -eq 0 ]; then
    status=warn
    notes+=("削除済み一覧の表を 1 件も読み取れませんでした")
  fi
  inventory_items vscode | jq -c --slurpfile removed "$list" '
    (reduce $removed[0][] as $r ({}; .[$r.id | ascii_downcase] += [$r])) as $by_id
    | [.[] | . as $e | ($by_id[$e.name | ascii_downcase] // [])[]
      | {id: $e.name, version: $e.version, removal_date, type}]' >"$WORK_DIR/vscode-items.json"
  evidence="$(jq -c --arg url "$VSCODE_REMOVED_URL" --argjson total "$count" --argjson installed "$(inventory_items vscode | jq length)" \
    '{url: $url, total: $total, installed: $installed, matched: length}' "$WORK_DIR/vscode-items.json")"
  envelope vscode layer2 "$status" "$count" "$evidence" ${notes[@]+"${notes[@]}"} <"$WORK_DIR/vscode-items.json"
}

cmd_vscode() {
  run_source vscode layer2 layer2_vscode
}

cmd_compare() {
  [ "$#" -eq 2 ] || die "使い方: vulncheck compare A B"
  version_compare "$1" "$2"
}

main() {
  local sub="${1:-}" output
  if [ "$#" -gt 0 ]; then
    shift
  fi
  case "$sub" in
    -h | --help | help)
      usage
      return 0
      ;;
    "")
      usage >&2
      return 1
      ;;
    compare)
      cmd_compare "$@"
      return
      ;;
    inventory | jpcert | all)
      [ "$#" -eq 0 ] || die "$sub は引数を取りません: $*"
      ;;
    osv | latest | vscode | kev | jvn)
      parse_inventory_option "$@"
      ;;
    *) die "不明なサブコマンドです: ${sub}（vulncheck --help を見てください）" ;;
  esac
  declare -F "cmd_$sub" >/dev/null || die "$sub は未実装です"
  INVENTORY_FILE="${INVENTORY_FILE:-$WORK_DIR/inventory.json}"
  if [ -n "${VULNCHECK_NOW:-}" ]; then
    NOW_EPOCH="$(iso_to_epoch "$VULNCHECK_NOW")" || die "VULNCHECK_NOW を ISO 8601 として解釈できません: $VULNCHECK_NOW"
  fi
  output="$WORK_DIR/envelopes.jsonl"
  "cmd_$sub" >"$output"
  jq -s . "$output"
}

main "$@"
